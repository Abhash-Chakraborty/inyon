<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app from 1.0. Its package (tech.abhashchakraborty.inyon, from the build) is the
     Capacitor app's, so it installs over it. The services and the notification receiver are the
     Capacitor app's too (apps/mobile/android/app/src/shared). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- usesCleartextTraffic is off: the page comes from inside the app. The phone core in
         libmain.so opens its own connections (a computer on the same network at ws://, with the
         link's own end-to-end encryption on top), and this setting doesn't govern those. -->
    <application
        android:name="tech.abhashchakraborty.inyon.app.InyonApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="dev.dioxus.main.MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- notification buttons (Mark read, an answer, Stop); only the app's own PendingIntents reach it -->
        <receiver
            android:name="tech.abhashchakraborty.inyon.device.NotificationActions"
            android:exported="false" />

        <!-- wakes the app for a few seconds to send an answer tapped on a notification -->
        <service
            android:name="tech.abhashchakraborty.inyon.device.AnswerService"
            android:exported="false"
            android:foregroundServiceType="shortService|dataSync" />

        <!-- keeps the app, and with it the phone core's connections, alive in the background while
             it's on. specialUse from Android 14: dataSync stops after 6 hours a day from Android 15 -->
        <service
            android:name="tech.abhashchakraborty.inyon.device.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps SSH connections to the user's own computers open so agent alerts arrive while the app is in the background" />
        </service>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- a few seconds awake when a machine sends something, so the alert is posted before the phone sleeps -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- nothing is scheduled or restored after a reboot, so these stay out even if a library asks -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
</manifest>
