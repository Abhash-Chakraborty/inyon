<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tether_ink">

    <androidx.camera.view.PreviewView
        android:id="@+id/scanner_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <dev.tether.app.device.ScannerOverlay
        android:id="@+id/scanner_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- placed under the viewfinder in code, once its size is known -->
    <TextView
        android:id="@+id/scanner_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="Point at the code tether-node shows"
        android:textColor="@color/tether_paper"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/scanner_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:alpha="0.6"
            android:gravity="center"
            android:text="The camera is on only while this screen is open. Nothing is recorded or sent."
            android:textColor="@color/tether_paper"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/scanner_torch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/scan_pill"
                android:contentDescription="Torch"
                android:src="@drawable/ic_scan_torch"
                android:visibility="invisible"
                android:tint="@color/tether_paper" />

            <TextView
                android:id="@+id/scanner_paste"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/scan_pill"
                android:gravity="center"
                android:text="Paste link instead"
                android:textColor="@color/tether_paper"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/scanner_close"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/scan_pill"
                android:contentDescription="Close"
                android:src="@drawable/ic_scan_close"
                android:tint="@color/tether_paper" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
