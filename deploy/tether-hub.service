# systemd user unit for the Tether hub.
# Adjust WorkingDirectory to where you cloned Tether, then:
# cp deploy/tether-hub.service ~/.config/systemd/user/ && systemctl --user enable --now tether-hub
[Unit]
Description=Tether hub
After=network-online.target

[Service]
WorkingDirectory=%h/tether/apps/hub
ExecStart=%h/.bun/bin/bun src/index.ts
Environment=NODE_ENV=production
Environment=PORT=4777
Environment=BIND=127.0.0.1
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
